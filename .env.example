# Copy this file to .env, then replace the placeholder with your real key.
# Never commit .env; it is already ignored by this repository.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Optional: select one preset at startup. You can still switch with /model.
CORECODER_MODEL_PROFILE=deepseek-fast

# Optional: override lazy Tool Schema activation budget (default: 10% of context,
# bounded to 1,024-12,000 estimated tokens).
# CORECODER_TOOL_SCHEMA_BUDGET=12000

# Optional: automatically expose up to this many relevant hidden Tool schemas
# for each new user turn. Set to 0 to keep only manual search/activation.
# CORECODER_TOOL_RETRIEVAL_LIMIT=5
